{
  "name": "repomentor",
  "version": "0.1.0",
  "description": "Developer-first AI code review and programming tutor workspace.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTM17/RepoMentor.git"
  },
  "homepage": "https://github.com/JasonTM17/RepoMentor#readme",
  "bugs": {
    "url": "https://github.com/JasonTM17/RepoMentor/issues"
  },
  "keywords": [
    "ai",
    "code-review",
    "programming-tutor",
    "developer-tools",
    "typescript",
    "nextjs",
    "nestjs",
    "prisma",
    "monorepo"
  ],
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "deps:install": "pnpm install --frozen-lockfile --ignore-scripts",
    "dev": "pnpm --recursive --if-present run dev",
    "lint": "eslint . && pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "build": "pnpm --recursive --if-present run build",
    "package:check": "node --test scripts/verify-package-payloads.test.mjs && node scripts/verify-package-payloads.mjs",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @repomentor/api run db:seed",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@repomentor/eslint-config": "workspace:*",
    "@repomentor/typescript-config": "workspace:*",
    "@prisma/client": "6.19.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "6.19.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  }
}
