{
  "name": "@repomentor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test ./dist/.test-dist/test/health.e2e-spec.js ./dist/.test-dist/test/environment-config.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repomentor/contracts": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repomentor/eslint-config": "workspace:*",
    "@repomentor/typescript-config": "workspace:*",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3"
  }
}
