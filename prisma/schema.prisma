datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  REFRESH_REUSE
  EXPIRED
  ADMIN
}

enum ReviewStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewEventType {
  SNAPSHOT
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewMode {
  QUICK
  STANDARD
  DEEP
}

enum QuotaAdmissionStatus {
  PENDING
  RESERVED
  ADMITTED
  DENIED
  INDETERMINATE
  RECONCILE_REQUIRED
}

model User {
  id              String           @id @default(cuid()) @db.VarChar(25)
  email           String           @unique @db.VarChar(320)
  displayName     String           @map("display_name") @db.VarChar(100)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  role            UserRole         @default(USER)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  quotaAdmissions QuotaAdmission[]
  sessions        Session[]
  reviews         Review[]

  @@map("users")
}

model Session {
  id                    String                   @id @default(cuid()) @db.VarChar(25)
  userId                String                   @map("user_id") @db.VarChar(25)
  refreshTokenHash      String                   @unique @map("refresh_token_hash") @db.Char(64)
  refreshTokenIssuedAt  DateTime                 @map("refresh_token_issued_at")
  refreshTokenExpiresAt DateTime                 @map("refresh_token_expires_at")
  lastUsedAt            DateTime?                @map("last_used_at")
  userAgent             String?                  @map("user_agent") @db.VarChar(512)
  ipHash                String?                  @map("ip_hash") @db.Char(64)
  status                SessionStatus            @default(ACTIVE)
  revokedAt             DateTime?                @map("revoked_at")
  revocationReason      SessionRevocationReason? @map("revocation_reason")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, refreshTokenExpiresAt])
  @@map("sessions")
}

model Review {
  id                   String        @id @default(cuid()) @db.VarChar(25)
  userId               String        @map("user_id") @db.VarChar(25)
  source               String        @db.VarChar(100000)
  language             String        @db.VarChar(32)
  mode                 ReviewMode    @default(STANDARD)
  eventSequence        Int           @default(0) @map("event_sequence")
  processingGeneration Int           @default(0) @map("processing_generation")
  status               ReviewStatus  @default(PENDING)
  deletedAt            DateTime?     @map("deleted_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  result               ReviewResult?
  events               ReviewEvent[]

  @@index([userId, deletedAt, createdAt])
  @@index([userId, status, deletedAt, createdAt])
  @@map("reviews")
}

model ReviewEvent {
  reviewId             String         @map("review_id") @db.VarChar(25)
  sequence             Int
  type                 ReviewEventType
  status               ReviewStatus
  processingGeneration Int            @map("processing_generation")
  resultAvailable      Boolean        @map("result_available")
  retryable            Boolean?
  createdAt            DateTime       @default(now()) @map("created_at")
  review               Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, sequence])
  @@index([reviewId, sequence])
  @@map("review_events")
}

model QuotaAdmission {
  id                 String               @id @default(cuid()) @db.VarChar(25)
  userId             String               @map("user_id") @db.VarChar(25)
  idempotencyKeyHash String               @map("idempotency_key_hash") @db.Char(64)
  requestFingerprintHash String?          @map("request_fingerprint_hash") @db.Char(64)
  fingerprintVersion     Int?             @map("fingerprint_version")
  reviewId           String               @unique @map("review_id") @db.VarChar(25)
  mode               ReviewMode
  utcDay             DateTime             @map("utc_day") @db.Date
  status             QuotaAdmissionStatus @default(PENDING)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKeyHash])
  @@index([userId, utcDay, mode, status])
  @@index([userId, reviewId])
  @@map("quota_admissions")
}

model ReviewResult {
  id              String       @id @default(cuid()) @db.VarChar(25)
  reviewId        String       @unique @map("review_id") @db.VarChar(25)
  provider        String       @db.VarChar(32)
  model           String       @db.VarChar(64)
  reasoningEffort String       @map("reasoning_effort") @db.VarChar(8)
  result          Json         @map("result_json")
  durationMs      Int          @map("duration_ms")
  attempts        Int
  createdAt       DateTime     @default(now()) @map("created_at")
  review          Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  usage           ReviewUsage?

  @@map("review_results")
}

model ReviewUsage {
  id                String       @id @default(cuid()) @db.VarChar(25)
  reviewResultId    String       @unique @map("review_result_id") @db.VarChar(25)
  inputTokens       Int          @map("input_tokens")
  outputTokens      Int          @map("output_tokens")
  totalTokens       Int          @map("total_tokens")
  cachedInputTokens Int?         @map("cached_input_tokens")
  createdAt         DateTime     @default(now()) @map("created_at")
  reviewResult      ReviewResult @relation(fields: [reviewResultId], references: [id], onDelete: Cascade)

  @@map("review_usages")
}
